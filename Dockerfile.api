# Core service for the STB: REST API plus the built web app.
FROM node:22-slim AS build
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl
WORKDIR /app
COPY . .
RUN npm ci
RUN npm run build -w @langkahbelajar/api && npm run build -w @langkahbelajar/web

FROM node:22-slim
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY packages/shared packages/shared
COPY apps/api/package.json apps/api/package.json
COPY apps/api/prisma apps/api/prisma
RUN npm ci --omit=dev -w @langkahbelajar/api -w @langkahbelajar/shared
RUN npx -w @langkahbelajar/api prisma generate
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/apps/web/dist apps/web/dist
WORKDIR /app/apps/api
USER node
EXPOSE 4000
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/server.cjs"]
