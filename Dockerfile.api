# Core REST API for the STB.
FROM node:22.23.5-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS base
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app

FROM base AS build
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/integration/package.json apps/integration/package.json
COPY apps/provider-sim/package.json apps/provider-sim/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN npm ci --no-audit --include-workspace-root -w @langkahbelajar/api -w @langkahbelajar/shared \
    && npm run build -w @langkahbelajar/api \
    && npm cache clean --force

FROM base
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY packages/shared packages/shared
COPY apps/api/package.json apps/api/package.json
COPY apps/integration/package.json apps/integration/package.json
COPY apps/provider-sim/package.json apps/provider-sim/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/api/prisma apps/api/prisma
RUN npm ci --no-audit --omit=dev -w @langkahbelajar/api -w @langkahbelajar/shared \
    && npm exec -w @langkahbelajar/api -- prisma generate \
    && npm cache clean --force
COPY --from=build /app/apps/api/dist apps/api/dist
WORKDIR /app/apps/api
USER node
EXPOSE 4000
CMD ["sh", "-c", "npx prisma migrate deploy && exec node dist/server.cjs"]
