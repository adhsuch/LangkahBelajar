{
  "name": "@langkahbelajar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "prisma generate && esbuild src/server.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.cjs --external:@prisma/client",
    "start": "node dist/server.cjs",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "test": "node test/run.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "api-key:create": "tsx --env-file=.env scripts/create-api-key.ts"
  },
  "dependencies": {
    "@langkahbelajar/shared": "*",
    "@prisma/client": "~6.19.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "prisma": "~6.19.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4"
  }
}
