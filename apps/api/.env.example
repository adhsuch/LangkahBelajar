# Local cluster from `npm run db:start`. It accepts connections from 127.0.0.1 only.
DATABASE_URL=postgresql://langkah@127.0.0.1:55432/langkahbelajar
PORT=4000
NODE_ENV=development
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
AUTH_RATE_LIMIT_MAX=20
SESSION_TTL_HOURS=168
# Integration service, deployed outside the STB.
INTEGRATION_URL=http://127.0.0.1:4100
INTEGRATION_API_KEY=local-dev-integration-key
INTEGRATION_TIMEOUT_MS=4000
CATALOG_CACHE_TTL_HOURS=168
