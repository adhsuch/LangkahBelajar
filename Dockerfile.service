# Bundled Node service. Build with --build-arg APP=integration or APP=provider-sim.
ARG APP=integration

FROM node:22.23.5-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS build
ARG APP
WORKDIR /app
COPY . .
RUN npm ci --ignore-scripts
RUN npm run build -w @langkahbelajar/${APP} && cp apps/${APP}/dist/server.cjs /server.cjs

FROM node:22.23.5-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
ENV NODE_ENV=production
COPY --from=build /server.cjs /app/server.cjs
USER node
CMD ["node", "/app/server.cjs"]
