# Copy to .env.docker and replace the placeholder values. Do not commit the copy.
POSTGRES_PASSWORD=replace-with-a-long-random-value
INTEGRATION_API_KEY=replace-with-a-long-random-value
# Address of the integration service as seen from the STB.
INTEGRATION_URL=https://integration.example.test
APP_PORT=8080
# Set to true when the STB is served through HTTPS.
COOKIE_SECURE=false
TRUST_PROXY_HOPS=1
# Required only with the public profile. Route the assigned hostname to http://gateway:80.
TUNNEL_TOKEN=
